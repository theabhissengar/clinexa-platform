# Server
NODE_ENV=development
PORT=3001
# Optional non-version path segment only. URI versioning is Nest-managed (/v1).
# Do not set this to "v1" — use Nest VersioningType.URI instead.
API_PREFIX=

# CORS (comma-separated origins for the admin app)
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://clinexa:clinexa@localhost:5432/clinexa?schema=public

# Logging
# Nest levels: error | warn | log | debug | verbose
# Default: debug in development, log otherwise
# LOG_LEVEL=debug
# Emit standard HTTP logs for /health (default false)
LOG_HEALTH_REQUESTS=false

# Swagger
SWAGGER_PATH=api/docs

# Authentication (required — generate strong random secrets; min 32 characters)
# Example: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_ABSOLUTE_TIMEOUT_HOURS=12
AUTH_REFRESH_COOKIE_NAME=clinexa_refresh
# false for local HTTP; true in staging/production (HTTPS)
AUTH_COOKIE_SECURE=false

# Optional Argon2id cost parameters
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4

# Dev seed only — set both to create a local Administrator (ROLE-009).
# Seeds the canonical RBAC catalog (roles, permissions, role↔permission matrix),
# then assigns ROLE-009 to this user. Never commit real passwords.
# Seed skips admin user creation if either is unset. Password min length: 12.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Dev seed only — set both to create a local Super Administrator (ROLE-010).
# Assigns ROLE-010 only (includes PERM-ADM-020 via the matrix). Never commit real passwords.
# Seed skips if either is unset. Password min length: 12.
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=

# Dev seed only — create Doctor / Pharmacist / Support / Operations / Marketing / Content users.
# Default emails: doctor@example.com, pharmacist@example.com, support@example.com,
# operations@example.com, marketing@example.com, content@example.com
# Override any email with SEED_DOCTOR_EMAIL, SEED_PHARMACIST_EMAIL, etc.
# Password min length: 12. Never commit real passwords.
# SEED_DEMO_STAFF=true
# SEED_DEMO_STAFF_PASSWORD=

# Object storage (Asset Library / shared StorageProvider)
# V1: local only. Future: s3 | r2 | azure | gcs behind the same interface.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=
# STORAGE_PUBLIC_BASE_URL=http://localhost:3001
# STORAGE_MAX_UPLOAD_BYTES=10485760
# STORAGE_UPLOAD_SESSION_TTL_MINUTES=60
