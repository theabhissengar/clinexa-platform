generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
  DELETED
}

enum UserGender {
  UNSPECIFIED
  MALE
  FEMALE
  OTHER
}

/// Unified identity for patients and staff (DB-001).
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  tokenVersion Int        @default(0) @map("token_version")

  /// Profile / contact (Users-owned; Auth never writes these).
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  displayName  String?    @map("display_name")
  phone        String?
  bio          String?
  /// Opaque User Media ref (future — not Asset Library).
  avatarMediaAssetId String? @map("avatar_media_asset_id")

  /// Patient demographics (allowlisted; PHI-aware access).
  dateOfBirth  DateTime?  @map("date_of_birth") @db.Date
  gender       UserGender @default(UNSPECIFIED)
  region       String?
  /// Opaque User Media / Document Management ref (future — not Asset Library).
  healthCardMediaAssetId String? @map("health_card_media_asset_id")

  /// Embedded billing/shipping contact snapshots until Address module.
  billingAddress  Json? @map("billing_address")
  shippingAddress Json? @map("shipping_address")

  /// Opaque PSP customer id refs (Payments owns sync semantics).
  stripeCustomerIdLive String? @map("stripe_customer_id_live")
  stripeCustomerIdTest String? @map("stripe_customer_id_test")

  /// Account preferences (notification prefs remain Notifications-owned).
  preferences Json?

  /// Internal support/ops notes (CRM-heavy).
  internalNotes String? @map("internal_notes")

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastActiveAt    DateTime? @map("last_active_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  roleAssignments      UserRoleAssignment[]
  passwordResetTokens  PasswordResetToken[]
  accountSecurityState AccountSecurityState?
  staffProfile         StaffProfile?
  changeHistory        UserChangeHistory[]
  activities           UserActivity[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Product roles ROLE-002–ROLE-010 (DB-002). Guest (ROLE-001) is not persisted.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

/// Capability dictionary PERM-<MOD>-### (DB-003).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  name        String
  description String?
  resource    String?
  action      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Many-to-many Roles ↔ Permissions (DB-004).
model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// User ↔ Role assignments (DB-005). Soft-revoke via revokedAt.
model UserRoleAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([userId, revokedAt])
  @@map("user_role_assignments")
}

/// Server-side session for revocation, idle timeout, and JWT sessionId (DB-006).
model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  refreshTokenHash   String    @map("refresh_token_hash")
  absoluteExpiresAt  DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt         DateTime  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent          String?   @map("user_agent")
  ip                 String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Time-limited single-use password reset tokens (DB-007). Auth-owned.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Lockout counters and abuse-protection state (DB-008). Auth-owned.
model AccountSecurityState {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime? @map("last_failed_login_at") @db.Timestamptz(3)
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_security_states")
}

/// Optional staff display/credentials prefs (DB-009) — not a separate person table.
model StaffProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  title              String?
  credentialsDisplay String?  @map("credentials_display")
  department         String?
  crmPreferences     Json?    @map("crm_preferences")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

/// Entity field/state diffs for one user (not platform Audit Log).
model UserChangeHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_change_history")
}

/// Attributed interactions on a user (not History diffs, not Audit).
model UserActivity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  kind      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_activities")
}

// ---------------------------------------------------------------------------
// Catalog (DB-010–014) — Products platform module
// ---------------------------------------------------------------------------

enum ProductLifecycleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ProductType {
  STANDARD
  VARIABLE
  BUNDLE
  KIT
  DIGITAL
  SIMPLE_SUBSCRIPTION
  VARIABLE_SUBSCRIPTION
}

enum CategoryLifecycleStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Configurable Store categories with SEO metadata (DB-010).
model Category {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String
  description          String?
  parentId             String?                 @map("parent_id") @db.Uuid
  lifecycleStatus      CategoryLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  seoTitle             String?                 @map("seo_title")
  seoDescription       String?                 @map("seo_description")
  sortOrder            Int                     @default(0) @map("sort_order")
  /// Opaque Asset Library asset id for category thumbnail.
  thumbnailMediaAssetId String?                @map("thumbnail_media_asset_id")
  minQuantity          Int?                    @map("min_quantity")
  maxQuantity          Int?                    @map("max_quantity")
  groupOf              Int?                    @map("group_of")
  displayType          String?                 @map("display_type")
  headerContentAlign   String?                 @map("header_content_align")
  headerTextAlign      String?                 @map("header_text_align")
  headerImageAssetId   String?                 @map("header_image_asset_id")
  /// Role codes that may view this category on Store; empty = everyone.
  contentPermissionRoles String[]              @default([]) @map("content_permission_roles")
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  productLinks ProductCategoryLink[]

  @@unique([slug])
  @@index([lifecycleStatus])
  @@index([parentId])
  @@map("categories")
}

/// Sellable catalog offerings (DB-011).
model Product {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String
  description              String?
  shortDescription         String?                @map("short_description")
  productType              ProductType            @default(STANDARD) @map("product_type")
  lifecycleStatus          ProductLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  isRxEligible             Boolean                @default(false) @map("is_rx_eligible")
  isFeatured               Boolean                @default(false) @map("is_featured")
  brandId                  String?                @map("brand_id") @db.Uuid
  /// Display label until Brands module owns records.
  brandName                String?                @map("brand_name")
  tags                     String[]               @default([])
  seoTitle                 String?                @map("seo_title")
  seoDescription           String?                @map("seo_description")
  seoCanonical             String?                @map("seo_canonical")
  medicalInfo              Json?                  @map("medical_info")
  /// Catalog attribute definitions: [{ name, values[], forVariation }].
  attributes               Json?
  /// Opaque featured image Asset Library id (consumers never store provider URLs).
  featuredMediaAssetId     String?                @map("featured_media_asset_id")
  /// Opaque ref until Questionnaires module owns bindings (OR-14).
  questionnaireBindingRef  String?                @map("questionnaire_binding_ref")

  /// Inventory (catalog-side; stock balances remain Inventory module).
  gtin                     String?
  soldIndividually         Boolean                @default(false) @map("sold_individually")

  /// Shipping dimensions (Store/fulfillment consumers; Shipping module later).
  weightLbs                Decimal?               @map("weight_lbs") @db.Decimal(12, 4)
  lengthIn                 Decimal?               @map("length_in") @db.Decimal(12, 4)
  widthIn                  Decimal?               @map("width_in") @db.Decimal(12, 4)
  heightIn                 Decimal?               @map("height_in") @db.Decimal(12, 4)
  shippingClass            String?                @map("shipping_class")
  oneTimeShipping          Boolean                @default(false) @map("one_time_shipping")

  /// Linked / bundle merchandising copy (targets live in product_relations).
  bundleSellsTitle         String?                @map("bundle_sells_title")
  bundleSellsDiscount      String?                @map("bundle_sells_discount")

  /// Default option picks for variable products.
  defaultVariationOptions  Json?                  @map("default_variation_options")

  /// Advanced catalog options.
  purchaseNote             String?                @map("purchase_note")
  menuOrder                Int                    @default(0) @map("menu_order")
  enableReviews            Boolean                @default(true) @map("enable_reviews")
  limitSubscription        String?                @map("limit_subscription")

  /// Per-product Stripe gateway presentation (Payments owns capture; Products stores prefs).
  stripeButtonPosition     String?                @map("stripe_button_position")
  stripeGateways           Json?                  @map("stripe_gateways")

  deletedAt                DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants       ProductVariant[]
  media          ProductMedia[]
  categoryLinks  ProductCategoryLink[]
  changeHistory  ProductChangeHistory[]
  activities     ProductActivity[]
  relationsFrom  ProductRelation[] @relation("ProductRelationSource")
  relationsTo    ProductRelation[] @relation("ProductRelationTarget")

  @@unique([slug])
  @@index([lifecycleStatus])
  @@index([isRxEligible])
  @@index([isFeatured])
  @@map("products")
}

/// SKU-level variants (DB-012).
model ProductVariant {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  sku           String
  label         String?
  optionValues  Json?     @map("option_values")
  priceCents    Int       @map("price_cents")
  salePriceCents Int?     @map("sale_price_cents")
  currency      String    @default("USD")
  isFulfillable Boolean   @default(true) @map("is_fulfillable")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sku])
  @@index([productId])
  @@map("product_variants")
}

/// Product ↔ media asset association only (DB-013). Does not own upload/storage.
model ProductMedia {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  /// Opaque Asset Library asset id (association only; Asset Library owns binaries).
  mediaAssetId String   @map("media_asset_id")
  alt          String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaAssetId])
  @@index([productId])
  @@map("product_media")
}

/// Many-to-many Products ↔ Categories (DB-014).
model ProductCategoryLink {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_category_links")
}

/// Related / cross-sell / upsell links (extension point).
model ProductRelation {
  id           String @id @default(uuid()) @db.Uuid
  sourceId     String @map("source_id") @db.Uuid
  targetId     String @map("target_id") @db.Uuid
  relationType String @map("relation_type")

  source Product @relation("ProductRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Product @relation("ProductRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@map("product_relations")
}

/// Entity change history for a product (not platform Audit Log).
model ProductChangeHistory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_change_history")
}

/// User interactions related to a product (not History diffs, not Audit).
model ProductActivity {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  kind      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_activities")
}

/// Reusable business asset lifecycle (DB-062 / docs/33).
enum AssetStatus {
  UPLOADED
  ACTIVE
  ARCHIVED
  DELETED
}

enum StorageProviderKind {
  LOCAL
  S3
  R2
  AZURE
  GCS
}

enum AssetUploadSessionStatus {
  PENDING
  UPLOADED
  FINALIZED
  EXPIRED
}

/// Asset Library metadata SoR (DB-062). Bytes live in StorageProvider — never PostgreSQL.
model Asset {
  id               String              @id @default(uuid()) @db.Uuid
  storageProvider  StorageProviderKind @map("storage_provider")
  storageKey       String              @map("storage_key")
  originalFilename String              @map("original_filename")
  mimeType         String              @map("mime_type")
  byteSize         Int                 @map("byte_size")
  width            Int?
  height           Int?
  altText          String?             @map("alt_text")
  caption          String?
  status           AssetStatus         @default(UPLOADED)
  createdByUserId  String?             @map("created_by_user_id") @db.Uuid
  archivedAt       DateTime?           @map("archived_at") @db.Timestamptz(3)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  changeHistory AssetChangeHistory[]
  activities    AssetActivity[]

  @@unique([storageProvider, storageKey])
  @@index([status])
  @@index([createdAt])
  @@index([mimeType])
  @@map("assets")
}

model AssetUploadSession {
  id               String                   @id @default(uuid()) @db.Uuid
  storageProvider  StorageProviderKind      @map("storage_provider")
  storageKey       String                   @map("storage_key")
  originalFilename String                   @map("original_filename")
  mimeType         String                   @map("mime_type")
  byteSize         Int?                     @map("byte_size")
  status           AssetUploadSessionStatus @default(PENDING)
  createdByUserId  String                   @map("created_by_user_id") @db.Uuid
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, expiresAt])
  @@index([createdByUserId])
  @@map("asset_upload_sessions")
}

model AssetChangeHistory {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  changes   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("asset_change_history")
}

model AssetActivity {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  kind      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("asset_activities")
}

// ---------------------------------------------------------------------------
// Inventory (DB-042, DB-043, DB-063–066 / docs/34) — ledger-first SoT
// ---------------------------------------------------------------------------

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  RESERVE
  RELEASE
  COMMIT
  RESTOCK
  ADJUST
  RECEIVE
}

enum ReservationStatus {
  PENDING
  COMMITTED
  RELEASED
  EXPIRED
}

enum OversellMode {
  PREVENT
  ALLOW
}

/// Warehouse master (DB-063). V1 seeds one default; every inventory row carries warehouse_id.
model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  code      String
  name      String
  status    WarehouseStatus @default(ACTIVE)
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances         InventoryBalance[]
  movements        StockMovement[]
  reservationLines StockReservationLine[]

  @@unique([code])
  @@index([isDefault])
  @@index([status])
  @@map("warehouses")
}

/// Materialized balance projection (DB-042) — not independently authoritative.
model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

/// Append-only inventory ledger — source of truth (DB-043).
model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  warehouseId      String            @map("warehouse_id") @db.Uuid
  productVariantId String            @map("product_variant_id") @db.Uuid
  movementType     StockMovementType @map("movement_type")
  quantityDelta    Int               @map("quantity_delta")
  orderId          String?           @map("order_id") @db.Uuid
  reservationId    String?           @map("reservation_id") @db.Uuid
  actorUserId      String?           @map("actor_user_id") @db.Uuid
  reason           String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservation StockReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([warehouseId, productVariantId, createdAt])
  @@index([orderId])
  @@index([reservationId])
  @@index([movementType, createdAt])
  @@map("stock_movements")
}

/// Reservation header (DB-064).
model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String?           @map("order_id") @db.Uuid
  status    ReservationStatus @default(PENDING)
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines     StockReservationLine[]
  movements StockMovement[]

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

/// Reservation lines (DB-065) — warehouse required on every line.
model StockReservationLine {
  id               String @id @default(uuid()) @db.Uuid
  reservationId    String @map("reservation_id") @db.Uuid
  warehouseId      String @map("warehouse_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid
  quantity         Int

  reservation StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([warehouseId, productVariantId])
  @@map("stock_reservation_lines")
}

/// Platform-wide inventory policies singleton row (DB-066).
model InventoryPolicy {
  id                         String      @id @default(uuid()) @db.Uuid
  /// Singleton marker — only one row with code "default".
  code                       String      @unique @default("default")
  oversellMode               OversellMode @default(PREVENT) @map("oversell_mode")
  reservationTimeoutMinutes  Int         @default(60) @map("reservation_timeout_minutes")
  lowStockThreshold          Int         @default(5) @map("low_stock_threshold")
  allowNegativeStock         Boolean     @default(false) @map("allow_negative_stock")
  /// Future FEFO/FIFO selector (named extension; unused in V1 logic).
  allocationStrategy         String?     @map("allocation_strategy")
  updatedByUserId            String?     @map("updated_by_user_id") @db.Uuid
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("inventory_policies")
}
