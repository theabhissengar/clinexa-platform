# Clinexa Platform — root environment example
# Copy relevant values into apps/api/.env and apps/admin/.env.local

NODE_ENV=development

# API (copy into apps/api/.env — see apps/api/.env.example)
PORT=3001
DATABASE_URL=postgresql://clinexa:clinexa@localhost:5432/clinexa?schema=public
CORS_ORIGINS=http://localhost:3000

# Admin (copy into apps/admin/.env.local — see apps/admin/.env.example)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Clinexa Internal Management
