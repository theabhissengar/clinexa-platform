# Clinexa Platform — root environment example
# Copy relevant values into apps/api/.env and apps/admin/.env.local

NODE_ENV=development

# API
API_PORT=3001
DATABASE_URL=postgresql://clinexa:clinexa@localhost:5432/clinexa?schema=public
CORS_ORIGINS=http://localhost:3000

# Admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
